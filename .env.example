# このファイルを .env にコピーして値を設定する(.env はGitへコミットしない)

# --- PostgreSQL (compose.yml) ---
POSTGRES_DB=seichi
POSTGRES_USER=seichi
POSTGRES_PASSWORD=seichi_dev_password

# --- Backend (Spring Boot) ---
POSTGRES_HOST_PORT=55432
DATABASE_URL=jdbc:postgresql://localhost:55432/seichi
DATABASE_USERNAME=seichi
DATABASE_PASSWORD=seichi_dev_password
# 例: openssl rand -base64 64 で生成した値を設定する
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# --- 初期管理者アカウント(設定した場合のみ起動時に作成) ---
ADMIN_USER_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 聖地画像の保存先(未設定ならbackend/var/spot-images) ---
SPOT_IMAGE_DIR=

# 本番用(compose.prod.yml)。サーバー上で .env.prod にコピーして値を設定する。
# .env.prod はGitへコミットしない。

# 公開ドメイン(例: seichi-map.duckdns.org)。CaddyのHTTPS証明書とCORS許可オリジンに使用する
DOMAIN=

# --- PostgreSQL ---
POSTGRES_DB=seichi
POSTGRES_USER=seichi
# 例: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Backend ---
# 例: openssl rand -base64 64(開発用の値を使い回さない)
JWT_SECRET=

# 初期管理者(初回起動で作成したら値を削除して再起動する)
ADMIN_USER_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Frontend(ビルド時にブラウザ用コードへ埋め込まれる) ---
# 本番用キー: HTTPリファラー制限(https://<DOMAIN>/*)と
# Maps JavaScript API / Geocoding API のみのAPI制限を必ず設定する
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 本番用の専用Map ID(DEMO_MAP_IDは使用しない)
NEXT_PUBLIC_GOOGLE_MAP_ID=

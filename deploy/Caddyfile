# 本番用リバースプロキシ。DOMAIN の証明書(Let's Encrypt)の取得・更新とHTTP→HTTPSリダイレクトはCaddyが自動で行う。
{$DOMAIN} {
	encode zstd gzip

	# セキュリティヘッダー(画面・APIの全レスポンスに付与する)
	header {
		# 以後はHTTPSでのみ接続させる(初回のhttp://アクセスを狙った盗聴・改ざん対策)
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# 他サイトのiframeへの埋め込みを禁止する(クリックジャッキング対策)
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
		-Server
	}

	# API(Spring Boot)。画像アップロード(1枚5MB)を通しつつ過大なリクエストを入口で拒否する
	handle /api/* {
		request_body {
			max_size 10MB
		}
		reverse_proxy backend:8080
	}

	# 画面(Next.js)
	handle {
		reverse_proxy frontend:3000
	}
}

# このファイルを .env.local にコピーして値を設定する(.env.local はGitへコミットしない)

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# NEXT_PUBLIC_ の値はブラウザへ公開される。
# Google Cloud側でHTTPリファラー制限と、Maps JavaScript API / Geocoding APIのみを
# 許可するAPI制限を必ず設定すること。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# DEMO_MAP_IDはローカル動作確認専用。本番では専用Map IDを使用する。
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
